{
  "name": "@forma/local-agent-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discover local AI agents and bridge their stdio to application clients",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "bin": {
    "forma-agent-bridge": "./src/cli.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/integration/*.test.ts"
  },
  "devDependencies": {
    "@forma/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
