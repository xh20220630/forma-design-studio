# Copy to .env at the repository root. Model credentials stay on the local API server.
OPENAI_API_KEY=
FORMA_API_BASE_URL=https://api.openai.com/v1
FORMA_TEXT_MODEL=gpt-4.1
FORMA_IMAGE_MODEL=gpt-image-1
# Optional token for local agents that call the API outside the browser.
FORMA_AGENT_TOKEN=
# Optional absolute data directory; defaults to .data at the repository root.
# FORMA_DATA_DIR=D:/forma-data

# Optional API port; the Vite development proxy uses the same value.
# FORMA_PORT=4310
FORMA_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174