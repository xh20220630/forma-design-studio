{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "baseUrl": ".", "paths": { "@/*": ["./src/*"] },
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "skipLibCheck": true, "moduleResolution": "bundler", "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": false, "noUnusedParameters": false
  },
  "include": ["src", "vite.config.ts"]
}
